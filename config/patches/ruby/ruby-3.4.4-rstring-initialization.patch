Backport the public-header hunks from Ruby commit 2bb6fe3 by Nobuyoshi Nakada:
https://github.com/ruby/ruby/commit/2bb6fe3854e2a4854bb89bfce4eaaea9d848fd1b
https://bugs.ruby-lang.org/issues/21629

Initialize the temporary RString through the upstream C/C++ compatible
RBASIC_INIT macro. This fixes Clang 21's diagnostic in native-gem feature
probes without disabling warnings. Internal Ruby implementation hunks from
the same commit are outside this public-header backport. Constructor context
is adapted to Ruby 3.4.4; the added initialization code is unchanged.

diff --git a/include/ruby/internal/core/rbasic.h b/include/ruby/internal/core/rbasic.h
--- a/include/ruby/internal/core/rbasic.h
+++ b/include/ruby/internal/core/rbasic.h
@@ -102,6 +102,9 @@ RBasic {
         klass(RBIMPL_VALUE_NULL)
     {
     }
+# define RBASIC_INIT RBasic()
+#else
+# define RBASIC_INIT {RBIMPL_VALUE_NULL}
 #endif
 };
 
diff --git a/include/ruby/internal/core/rstring.h b/include/ruby/internal/core/rstring.h
--- a/include/ruby/internal/core/rstring.h
+++ b/include/ruby/internal/core/rstring.h
@@ -395,7 +395,7 @@ rbimpl_rstring_getmem(VALUE str)
     }
     else {
         /* Expecting compilers to optimize this on-stack struct away. */
-        struct RString retval;
+        struct RString retval = {RBASIC_INIT};
         retval.len = RSTRING_LEN(str);
         retval.as.heap.ptr = RSTRING(str)->as.embed.ary;
         return retval;
