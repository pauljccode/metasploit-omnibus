@@ -0,0 +1,221 @@
+name: CentOS 6 repaired builder package validation
+
+on:
+  push:
+    branches:
+      - test/centos6-repaired-package
+
+permissions:
+  contents: read
+
+jobs:
+  docker_intel:
+    runs-on: ${{ matrix.docker.runner || matrix.os }}
+    timeout-minutes: 180
+
+    strategy:
+      fail-fast: false
+      matrix:
+        os:
+          - ubuntu-latest
+        # From: 'ls ./docker/'
+        docker:
+          - name: 'centos6-x64'
+            runner: ubuntu-latest
+            linux32: ''
+            previousDockerhubImage: 'rapid7/msf-centos6-x64-omnibus:2024_04'
+            installer: 'sudo rpm -i metasploit-omnibus/pkg/metasploit-framework*.rpm'
+
+    name: ${{ matrix.docker.runner || matrix.os }} - ${{ matrix.docker.name }}
+    steps:
+      - name: Record initial runner capacity
+        run: |
+          df -h
+          df -i
+          docker system df
+
+      - name: Checkout omnibus
+        uses: actions/checkout@v4
+        with:
+          path: metasploit-omnibus
+
+      - uses: dorny/paths-filter@de90cc6fb38fc0963ad72b210f1f284cd68cea36
+        id: changes
+        with:
+          # Compare with the actual upstream base of these dependency changes.
+          base: 494135f0cd93c71145b9ad1f173b8d696c67b0ba
+          filters: |
+            docker:
+              - 'docker/**'
+          working-directory: metasploit-omnibus
+
+      - name: Require fresh builder validation
+        env:
+          HAS_MODIFIED_DOCKERFILES: ${{ steps.changes.outputs.docker }}
+        run: test "$HAS_MODIFIED_DOCKERFILES" = true
+
+      # Set the env vars for either a new build, or a previously successful build
+      - name: Set docker build metadata
+        run: |
+          BUILD_DATE=$(date "+%Y_%m")
+          export BUILD_DATE
+          echo "BUILD_DATE=$BUILD_DATE" >> "$GITHUB_ENV"
+          if test "${HAS_MODIFIED_DOCKERFILES}" = 'true'; then
+            echo 'New build required'
+            echo "DOCKER_IMAGE=rapid7/${DOCKER_NAME}-omnibus:${BUILD_DATE}" >> "$GITHUB_ENV"
+          else
+            echo 'Reusing old image'
+            echo "DOCKER_IMAGE=${PREVIOUS_DOCKERHUB_IMAGE}" >> "$GITHUB_ENV"
+          fi
+        env:
+          HAS_MODIFIED_DOCKERFILES: ${{ steps.changes.outputs.docker }}
+          DOCKER_NAME: ${{ matrix.docker.name }}
+          PREVIOUS_DOCKERHUB_IMAGE: ${{ matrix.docker.previousDockerhubImage }}
+
+      - name: Build Docker image
+        if: steps.changes.outputs.docker == 'true'
+        run: |
+          set -euxo pipefail
+          cd metasploit-omnibus
+          docker build --progress=plain --tag "$DOCKER_IMAGE" \
+            -f "./docker/$IMAGE_NAME/Dockerfile" "./docker/$IMAGE_NAME" 2>&1 | tee ../centos6-builder.log
+          docker image inspect "$DOCKER_IMAGE" --format '{{.Id}}'
+        env:
+          IMAGE_NAME: ${{ matrix.docker.name }}
+
+      # Checkout again - but with the submodules enabled to start a real build
+      - name: Checkout omnibus and submodules
+        uses: actions/checkout@v4
+        with:
+          submodules: true
+          path: metasploit-omnibus
+
+      - name: Stage the verified upgrade archives for this private trial
+        run: |
+          curl --fail --location --output metasploit-omnibus/local/cache/zlib-1.4.tar.gz https://zlib.net/fossils/zlib-1.4.tar.gz
+          echo "02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584  metasploit-omnibus/local/cache/zlib-1.4.tar.gz" | shasum -a 256 -c -
+          curl --fail --location --output metasploit-omnibus/local/cache/libffi-3.8.0.tar.gz https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz
+          echo "7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4  metasploit-omnibus/local/cache/libffi-3.8.0.tar.gz" | shasum -a 256 -c -
+
+      - name: Make room for the CentOS 6 package build
+        run: |
+          test "$RUNNER_ENVIRONMENT" = github-hosted
+          df -h
+          df -i
+          docker system df
+          # This native CentOS 6 build does not use the hosted Android SDK.
+          if test -d /usr/local/lib/android/sdk; then
+            sudo du -sh /usr/local/lib/android/sdk
+            sudo rm -rf -- /usr/local/lib/android/sdk
+          fi
+          df -h
+          df -i
+
+      - name: Run omnibus
+        run: |
+          set -euxo pipefail
+          mkdir -p metasploit-omnibus/certs
+          curl -L -o metasploit-omnibus/certs/ca-certificates.crt https://curl.haxx.se/ca/cacert.pem
+
+          # If required, change reported architecture in new program environment and set personality flags
+          if [ ! -z "${LINUX32}" ] ; then
+            echo 'setting linux32'
+            /bin/bash -x -c "docker run --rm --volume $(pwd):$(pwd) --workdir $(pwd) --user jenkins ${DOCKER_IMAGE} linux32 /bin/bash -l -c 'cd metasploit-omnibus && ARCH=x86_64 make'" 2>&1 | tee centos6-build.log
+          else
+            /bin/bash -x -c "docker run --rm --volume $(pwd):$(pwd) --workdir $(pwd) --user jenkins ${DOCKER_IMAGE} /bin/bash -l -c 'cd metasploit-omnibus && make'" 2>&1 | tee centos6-build.log
+          fi
+        env:
+          LINUX32: ${{ matrix.docker.linux32 }}
+
+      - name: Test artifact
+        run: |
+          echo "Testing artifact"
+
+          cat > test_script.sh <<EOF
+          #!/bin/bash -ex
+          find metasploit-omnibus/pkg
+          $INSTALL_ARTIFACT
+          /opt/metasploit-framework/embedded/bin/ruby metasploit-omnibus/ci/verify-database-readiness-package.rb /opt/metasploit-framework
+          /opt/metasploit-framework/embedded/bin/ruby metasploit-omnibus/ci/verify-upgraded-dependency.rb /opt/metasploit-framework
+
+          mkdir ~/.msf4; touch ~/.msf4/initial_setup_complete
+
+          msfconsole -qx 'setg variable test; version; exit'
+          msfvenom -p windows/meterpreter/reverse_tcp -f exe -o test.exe
+          msfd -h
+          msfrpc -h
+          msfrpcd -h
+          msfdb -h
+          msfbinscan -h
+          msfrop -h
+          msfelfscan -h
+          msfmachscan -h
+          msfpescan -h
+          # msfupdate
+
+          # Test database connectivity (catches libpq/OpenSSL ABI mismatches)
+          msfdb init
+          msfconsole -qx 'db_status; exit' | tee /tmp/db_status.txt
+          grep -q "Connected" /tmp/db_status.txt
+
+          # Test TCP connection
+          ruby -ryaml -e '
+            path = File.expand_path("~/.msf4/database.yml")
+            cfg = if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.1")
+              YAML.load_file(path, aliases: true)
+            else
+              YAML.load_file(path)
+            end
+            prod = cfg["production"]
+            prod["host"] = "127.0.0.1"
+            prod["port"] = prod.fetch("port", 5432)
+            prod.delete("socket")
+            File.write(path, YAML.dump(cfg))
+          '
+          msfconsole -qx 'db_status; exit' | tee /tmp/db_status.txt
+          grep -q "Connected" /tmp/db_status.txt
+          EOF
+
+          chmod +x ./test_script.sh
+
+          # If required, change reported architecture in new program environment and set personality flags
+          if [ ! -z "${LINUX32}" ] ; then
+            echo 'setting linux32'
+            /bin/bash -x -c "docker run --rm --volume $(pwd):$(pwd) --workdir $(pwd) --user jenkins ${DOCKER_IMAGE} linux32 /bin/bash -l -c './test_script.sh'"
+          else
+            /bin/bash -x -c "docker run --rm --volume $(pwd):$(pwd) --workdir $(pwd) --user jenkins ${DOCKER_IMAGE} /bin/bash -l -c './test_script.sh'"
+          fi
+        env:
+          LINUX32: ${{ matrix.docker.linux32 }}
+          INSTALL_ARTIFACT: ${{ matrix.docker.installer }}
+
+      - name: Record final runner capacity
+        if: always()
+        run: |
+          df -h
+          df -i
+          docker system df
+
+      - name: Preserve build diagnostics
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: centos6-build-diagnostics
+          path: |
+            centos6-builder.log
+            centos6-build.log
+          if-no-files-found: warn
+          retention-days: 7
+
+      - name: Upload artifact
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: metasploit-${{ matrix.docker.name }}-installers
+          path: |
+            metasploit-omnibus/pkg/*.pkg
+            metasploit-omnibus/pkg/*.rpm
+            metasploit-omnibus/pkg/*.msi
+            metasploit-omnibus/pkg/*.deb
+          if-no-files-found: error
+          retention-days: 7
