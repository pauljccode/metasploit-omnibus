diff --git a/ci/verify-macos-deployment-target.rb b/ci/verify-macos-deployment-target.rb
new file mode 100644
index 0000000..664b7b2
--- /dev/null
+++ b/ci/verify-macos-deployment-target.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+require_relative "../scripts/verify_macos_package"
+require "rubygems/version"
+require "json"
+
+root, architecture, maximum = ARGV
+raise "Usage: ROOT ARCH MAXIMUM_MACOS" unless maximum
+verifier = MacOSPackageVerifier.new(File.realpath(root), architecture)
+count = verifier.verify!
+versions = verifier.checked_images.sort.to_h do |path|
+  output, error, status = Open3.capture3("/usr/bin/otool", "-arch", architecture, "-l", path)
+  raise error unless status.success?
+  found = output.scan(/^\s*minos (\d+(?:\.\d+)*)\s*$/).flatten
+  if found.empty?
+    found = output.scan(/cmd LC_VERSION_MIN_MACOSX\s+cmdsize \d+\s+version (\d+(?:\.\d+)*)/).flatten
+  end
+  raise "Expected one macOS deployment target: #{path}" unless found.length == 1
+  [path.delete_prefix("#{File.realpath(root)}/"), found.fetch(0)]
+end
+puts JSON.pretty_generate(checked_images: count, minimum_versions: versions)
+too_new = versions.select { |_, version| Gem::Version.new(version) > Gem::Version.new(maximum) }
+raise "Images require newer macOS than #{maximum}: #{too_new}" unless too_new.empty?
+puts "PACKAGED_MACOS_DEPLOYMENT_TARGET_VERIFIED maximum=#{maximum} images=#{count}"
diff --git a/ci/verify-nokogiri-source-cache.rb b/ci/verify-nokogiri-source-cache.rb
new file mode 100644
index 0000000..7a94b17
--- /dev/null
+++ b/ci/verify-nokogiri-source-cache.rb
@@ -0,0 +1,35 @@
+# frozen_string_literal: true
+
+require "yaml"
+require "digest"
+
+module NokogiriSourceCacheReceipt
+  def self.verify(cache_dir, gem_directory:, sha256:, ruby_platform:)
+    receipt = YAML.safe_load_file(File.join(cache_dir, "source-cache-use.yml"), aliases: false)
+    raise "Invalid cache receipt schema" unless receipt.fetch("schema") == 1
+    raise "Unexpected libiconv archive" unless receipt.fetch("archive") == "libiconv-1.18.tar.gz"
+    raise "Unexpected libiconv SHA-256" unless receipt.fetch("sha256") == sha256
+    unless receipt.fetch("gem_directory").casecmp?(gem_directory.tr("\\", "/"))
+      raise "Receipt is not from expected embedded Nokogiri"
+    end
+    raise "Unexpected build platform" unless receipt.fetch("ruby_platform") == ruby_platform
+    dependency = YAML.safe_load_file(File.join(gem_directory, "dependencies.yml"), aliases: false).fetch("libiconv")
+    unless dependency.fetch("version") == "1.18" && dependency.fetch("sha256") == sha256
+      raise "Installed Nokogiri dependency differs"
+    end
+    # Nokogiri removes ports/archives after compilation. The receipt attests to
+    # staging there; rehash the retained source cache, not the cleaned directory.
+    archive = File.join(cache_dir, receipt.fetch("archive"))
+    raise "Retained source archive differs" unless Digest::SHA256.file(archive).hexdigest == sha256
+    receipt
+  end
+end
+
+if $PROGRAM_NAME == __FILE__
+  receipt = NokogiriSourceCacheReceipt.verify(ENV.fetch("MSF_NOKOGIRI_SOURCE_CACHE"),
+    gem_directory: "C:/metasploit-framework/embedded/lib/ruby/gems/3.4.0/gems/nokogiri-1.19.4",
+    sha256: "3b08f5f4f9b4eb82f151a7040bfd6fe6c6fb922efe4b1659c66ea933276965e8",
+    ruby_platform: "x64-mingw-ucrt")
+  puts YAML.dump(receipt)
+  puts "NOKOGIRI_PRODUCTION_SOURCE_CACHE_RECEIPT_VERIFIED"
+end
diff --git a/ci/verify-upgraded-dependency.rb b/ci/verify-upgraded-dependency.rb
new file mode 100644
index 0000000..381eacd
--- /dev/null
+++ b/ci/verify-upgraded-dependency.rb
@@ -0,0 +1,38 @@
+# frozen_string_literal: true
+
+require "zlib"
+require "stringio"
+require "fiddle"
+require "rbconfig"
+
+root = ARGV.fetch(0)
+expected_zlib = "1.4"
+raise "Unexpected zlib headers" unless Zlib::ZLIB_VERSION == expected_zlib
+raise "Unexpected zlib runtime" unless Zlib.zlib_version == expected_zlib
+input = (0..255).to_a.pack("C*") * 1024
+raise "Deflate round trip failed" unless Zlib::Inflate.inflate(Zlib::Deflate.deflate(input)) == input
+io = StringIO.new
+writer = Zlib::GzipWriter.new(io)
+writer.write(input)
+writer.finish
+raise "Gzip round trip failed" unless Zlib::GzipReader.new(StringIO.new(io.string)).read.b == input
+closure = Fiddle::Closure::BlockCaller.new(Fiddle::TYPE_INT, [Fiddle::TYPE_INT, Fiddle::TYPE_INT]) { |a, b| a + b }
+call = Fiddle::Function.new(closure, [Fiddle::TYPE_INT, Fiddle::TYPE_INT], Fiddle::TYPE_INT)
+raise "Fiddle call and closure failed" unless call.call(17, 25) == 42
+closure.free
+filename = RbConfig::CONFIG.fetch("host_os").include?("darwin") ? "libffi.8.dylib" : "libffi.so.8"
+handle = Fiddle::Handle.new(File.join(root, "embedded/lib", filename))
+version = Fiddle::Function.new(handle["ffi_get_version"], [], Fiddle::TYPE_VOIDP).call.to_s
+raise "Unexpected libffi runtime: #{version}" unless version == "3.8.0"
+extensions = $LOADED_FEATURES.grep(%r{/(?:fiddle|zlib)\.(?:bundle|so)$})
+raise "Missing native extension evidence" unless extensions.length == 2
+extensions.each do |extension|
+  command = RbConfig::CONFIG.fetch("host_os").include?("darwin") ? ["otool", "-L", extension] : ["ldd", extension]
+  output = IO.popen(command, &:read)
+  raise "Dependency inspection failed" unless $?.success?
+  library = File.basename(extension).start_with?("fiddle.") ? "libffi" : "libz"
+  puts output
+  resolved = output.gsub("@executable_path/../lib/", File.expand_path("../lib/", File.dirname(RbConfig.ruby)) + "/")
+  raise "Extension did not link packaged #{library}" unless resolved.include?(File.join(root, "embedded/lib", library))
+end
+puts "PACKAGED_COMPRESSION_AND_FIDDLE_PASSED zlib=#{Zlib.zlib_version}"
