diff --git a/.github/workflows/centos6-mirror-standalone.yml b/.github/workflows/centos6-mirror-standalone.yml
new file mode 100644
index 0000000..6bbc1b2
--- /dev/null
+++ b/.github/workflows/centos6-mirror-standalone.yml
@@ -0,0 +1,42 @@
+name: CentOS 6 standalone mirror validation
+
+on:
+  push:
+    branches:
+      - test/centos6-mirror-standalone
+
+permissions:
+  contents: read
+
+jobs:
+  builder:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Build the CentOS 6 image
+        timeout-minutes: 50
+        run: |
+          set -euxo pipefail
+          docker build --progress=plain --tag msf-centos6-builder \
+            docker/centos6-x64 2>&1 | tee centos6-builder.log
+
+      - name: Check the builder toolchain
+        run: |
+          docker run --rm --user jenkins msf-centos6-builder /bin/bash -l -ec '
+            test "$(ruby -e "print RUBY_VERSION")" = 3.0.6
+            ruby -ropenssl -rzlib -e "puts [RUBY_VERSION, OpenSSL::OPENSSL_VERSION, Zlib.zlib_version]"
+            bundle --version
+            gcc --version
+            rpm -q rpmforge-release git fakeroot ccache
+          '
+
+      - name: Preserve builder diagnostics
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: centos6-builder-diagnostics
+          path: centos6-builder.log
+          if-no-files-found: warn
+          retention-days: 7
